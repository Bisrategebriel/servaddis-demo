# Copy to .env and fill in. See docs/02-TRD.md §10.
DATABASE_URL="file:../data/servaddis.db"   # relative to prisma/, so the db lives in ./data
SESSION_SECRET=""        # 32+ random bytes
OTP_HMAC_SECRET=""       # 32+ random bytes
DEMO_MODE=1
DEMO_OTP=123456
WEBHOOK_SECRET=""
# LAN URL (phone on the same hotspot) or the current Cloudflare quick-tunnel URL (D-9)
PUBLIC_BASE_URL="http://localhost:3000"
UPLOAD_DIR="./data/uploads"
CARD_DIR="./data/cards"
# Optional toolkit lock. `pnpm demo --tunnel` sets one automatically.
DEMO_TOOLKIT_PASSCODE=""
TELEGRAM_REAL=0
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHANNEL_ID=""
TZ="Africa/Addis_Ababa"
